# ============================================================
# Fivefold Lead API — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER expose server-side secrets to the React client.
# ============================================================

# Application
NODE_ENV=development
PORT=3001
# Comma-separate multiple allowed origins, e.g.:
# CLIENT_URL=https://www.fivefoldrenewable.com,https://fivefoldrenewable.com,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Max JSON request body size accepted by POST /api/leads
BODY_SIZE_LIMIT=16kb

# Rate limiting for POST /api/leads (in-memory, per server instance).
# NOTE: these are read from the real process environment at startup —
# they must be exported in the shell / hosting platform, not only in this
# .env file, to take effect (see docs/src/10-lead-submission-architecture.md).
LEADS_RATE_LIMIT_TTL_MS=3600000
LEADS_RATE_LIMIT_MAX=5

# ============================================================
# Database — Supabase PostgreSQL, accessed via Prisma — SERVER-SIDE ONLY
# DATABASE_URL: pooled connection (PgBouncer, port 6543) — used at runtime.
# DIRECT_URL:   direct connection (port 5432) — used by `prisma migrate`.
# Get both from Supabase → Project Settings → Database → Connection string.
# Must never appear in the React client bundle.
# ============================================================
DATABASE_URL=
DIRECT_URL=

# ============================================================
# WhatsApp Business Cloud API — SERVER-SIDE ONLY
# These credentials authenticate with Meta's Graph API.
# They must never appear in the React client bundle.
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
