# ============================================================
# Fivefold Lead API — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# NEVER expose server-side secrets to the React client.
# ============================================================

# Application
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# ============================================================
# Supabase — SERVER-SIDE ONLY
# The service-role key bypasses Row Level Security.
# It must never appear in the React client bundle.
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# WhatsApp Business Cloud API — SERVER-SIDE ONLY
# These credentials authenticate with Meta's Graph API.
# They must never appear in the React client bundle.
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
