# ============================================================
# Fivefold Client — Environment Variables
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git.
# NEXT_PUBLIC_ variables are safe to expose to the browser
# (they are embedded in the client bundle at build time).
# ============================================================

# URL of the NestJS API server
# Development: http://localhost:3001
# Production:  https://api.fivefoldrenewable.com
NEXT_PUBLIC_API_URL=http://localhost:3001
